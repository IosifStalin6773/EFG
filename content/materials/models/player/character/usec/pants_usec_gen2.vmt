"VertexlitGeneric"
{
	"$basetexture" "models/player/character/usec/Pants_usec_Gen2"
	"$bumpmap" "models/player/character/usec/Pants_usec_Gen2_n"
    $phong "1"
    $basemapalphaphongmask "1"
    $phongfresnelranges "[0.04 0.15 1.0]"
    $phongexponent "25"
    $phongboost "1"


    $envmap "env_cubemap"
    $basealphaenvmapmask"1"
    $envmaptint "[0.02 0.02 0.02]"
    $envmapfresnel "0.5"
}
