"VertexlitGeneric"
{
	"$basetexture" "models/player/character/USEC_head_1_d"
	"$bumpmap" "models/player/character/USEC_head_1_n"
    $phong "1"
    $phongfresnelranges "[0.04 0.15 1.0]"
    $phongexponent "25"
    $phongboost "1"

    $envmap "env_cubemap"
    $normalmapalphaenvmapmask "1"
    $envmaptint "[0.02 0.02 0.02]"
    $envmapfresnel "0.5"
}
